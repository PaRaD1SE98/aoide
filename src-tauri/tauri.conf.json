{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aoide",
  "version": "0.5.10",
  "identifier": "io.github.parad1se98.aoide",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PaRaD1SE98",
    "copyright": "Copyright (c) 2026 PaRaD1SE98",
    "category": "Productivity",
    "shortDescription": "Local push-to-talk voice typing for Windows",
    "longDescription": "Press a hotkey, speak, and Aoide transcribes your speech locally with SenseVoice or whisper.cpp, optionally polishes it with an LLM, and types it into the focused input box.",
    "resources": {
      "vendor/vulkan-1.dll": "vulkan-1.dll",
      "vendor/THIRD_PARTY_LICENSES.html": "THIRD_PARTY_LICENSES.html"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwODc5MTQ3OEE1RjBFQTIKUldTaURsK0tSNUdINFBBMEFJSnF4U2pLZXpwMlVjNnRKcE8xSTBlM255aG41Y1RCekFWcWhNUnUK",
      "endpoints": ["https://github.com/PaRaD1SE98/aoide/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
